<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</AutoCADDir>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>NssTkkEditor.V002</AssemblyName>
    <Version>0.2.3</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TkkEditor.cs" />
    <Compile Include="AnalysisWorker.cs" />
    <Compile Include="IssueReview.cs" />
    <Compile Include="AppliedState.cs" />
    <Compile Include="CctvCommands.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADDir)/AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADDir)/AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADDir)/AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>