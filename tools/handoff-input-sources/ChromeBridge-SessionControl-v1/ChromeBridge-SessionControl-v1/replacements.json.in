    "const grants = new ControlGrants();",
    "const grants = new ControlGrants();\n// Per-Chrome-session approvals: survives bridge process/epoch restarts, not browser restart.\nconst GRANTS_KEY = 'chromeBridgeSessionGrantsV1';\nasync function persistGrants() {\n  await chrome.storage.session.set({ [GRANTS_KEY]: Object.fromEntries(grants.grants) });\n}\nasync function forgetGrant(origin) {\n  const data = (await chrome.storage.session.get(GRANTS_KEY))[GRANTS_KEY] || {};\n  delete data[origin];\n  await chrome.storage.session.set({ [GRANTS_KEY]: data });\n}\nasync function restoreGrants() {\n  const stored = (await chrome.storage.session.get(GRANTS_KEY))[GRANTS_KEY] || {};\n  const sites = await getSites();\n  const now = Date.now();\n  const restored = {};\n  for (const [origin, expires] of Object.entries(stored)) {\n    if (!CONTROL_ORIGINS[origin] || sites[origin]?.mode !== 'chat') continue;\n    if (!Number.isFinite(expires) || expires <= now || expires > now + 240 * 60000) continue;\n    if (!(await chrome.permissions.contains({ origins: [origin + '/*'] }))) continue;\n    restored[origin] = expires;\n  }\n  grants.grants = new Map(Object.entries(restored));\n  await chrome.storage.session.set({ [GRANTS_KEY]: restored });\n  refreshGrantLabels();\n}"
