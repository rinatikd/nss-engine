{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chrome Bridge Windows broker claim-shape v2 (untrusted until controller-signed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "nonce", "policySha256", "brokerSha256", "codexSha256", "workspaceId", "evidence"],
  "properties": {
    "protocol": { "const": 2 },
    "nonce": { "$ref": "#/$defs/hash" },
    "policySha256": { "$ref": "#/$defs/hash" },
    "brokerSha256": { "$ref": "#/$defs/hash" },
    "codexSha256": { "$ref": "#/$defs/hash" },
    "workspaceId": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["appContainer", "network", "credentials", "workspace", "handles", "environment", "job", "cleanup"],
      "properties": {
        "appContainer": { "type": "object", "additionalProperties": false, "required": ["enabled", "sid", "lowPrivilege", "lpac", "capabilitySids"], "properties": { "enabled": { "const": true }, "sid": { "type": "string", "pattern": "^S-1-15-2-(?:[0-9]+-){1,16}[0-9]+$" }, "lowPrivilege": { "const": true }, "lpac": { "const": true }, "capabilitySids": { "type": "array", "maxItems": 0 } } },
        "network": { "type": "object", "additionalProperties": false, "required": ["outboundAllowed", "denialProbePassed"], "properties": { "outboundAllowed": { "const": false }, "denialProbePassed": { "const": true } } },
        "credentials": { "type": "object", "additionalProperties": false, "required": ["profileReadDenied", "codexHomeReadDenied", "syntheticCredentialReadDenied"], "properties": { "profileReadDenied": { "const": true }, "codexHomeReadDenied": { "const": true }, "syntheticCredentialReadDenied": { "const": true } } },
        "workspace": { "type": "object", "additionalProperties": false, "required": ["pathSha256", "readOnly", "writeProbeDenied"], "properties": { "pathSha256": { "$ref": "#/$defs/hash" }, "readOnly": { "const": true }, "writeProbeDenied": { "const": true } } },
        "handles": { "type": "array", "items": { "enum": ["stdin", "stdout", "stderr"] }, "minItems": 3, "maxItems": 3, "uniqueItems": true },
        "environment": { "type": "array", "items": { "enum": ["SystemRoot", "TEMP", "TMP"] }, "minItems": 3, "maxItems": 3, "uniqueItems": true },
        "job": { "type": "object", "additionalProperties": false, "required": ["killOnClose", "activeProcessLimit", "breakawayDisabled", "childProcessRestricted", "memoryLimitBytes", "cpuTimeLimit100ns", "descendantsEmptyAfterCrash"], "properties": { "killOnClose": { "const": true }, "activeProcessLimit": { "const": 1 }, "breakawayDisabled": { "const": true }, "childProcessRestricted": { "const": true }, "memoryLimitBytes": { "type": "integer", "minimum": 67108864, "maximum": 536870912 }, "cpuTimeLimit100ns": { "type": "integer", "minimum": 100000 }, "descendantsEmptyAfterCrash": { "const": true } } },
        "cleanup": { "type": "object", "additionalProperties": false, "required": ["fixtureRemoved", "handlesClosed", "childTerminated"], "properties": { "fixtureRemoved": { "const": true }, "handlesClosed": { "const": true }, "childTerminated": { "const": true } } }
      }
    }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
