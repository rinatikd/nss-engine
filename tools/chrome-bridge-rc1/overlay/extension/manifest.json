{
  "manifest_version": 3,
  "name": "Chrome Bridge — Agent Hub",
  "version": "0.2.1",
  "description": "Explicitly connect selected website origins (including AI chat sites) to your local MCP bridge.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:17381/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "Chrome Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "version_name": "0.2.1-rc.1"
}
