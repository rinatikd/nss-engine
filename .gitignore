# Main-PC workspace: publish code deliberately; keep local engineering material in place.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/CLAUDE.md
!/GEMINI.md
!/skills-lock.json
!/requirements-test.txt
!/docs/
!/tools/
!/.githooks/
!/.github/
!/.agents/
!/.agents/skills/
/.agents/*
!/.agents/skills/
!/work/
/work/*
!/work/*.py
!/work/NSS_TKK_Editor_v0.2/
!/work/NSS_AutoDebug_v0423/
/work/NSS_TKK_Editor_v0.2/*
!/work/NSS_TKK_Editor_v0.2/source/
!/work/NSS_TKK_Editor_v0.2/engine/
!/work/NSS_TKK_Editor_v0.2/modules/
!/work/NSS_TKK_Editor_v0.2/scripts/
!/work/NSS_TKK_Editor_v0.2/tests/
!/work/NSS_TKK_Editor_v0.2/native/
!/work/NSS_TKK_Editor_v0.2/*.md
!/work/NSS_TKK_Editor_v0.2/*.cmd
/work/NSS_AutoDebug_v0423/*
!/work/NSS_AutoDebug_v0423/autocad/
!/work/NSS_AutoDebug_v0423/nss_engine/
!/work/NSS_AutoDebug_v0423/scripts/
!/work/NSS_AutoDebug_v0423/tests/
!/work/NSS_AutoDebug_v0423/contract_tests/
!/work/NSS_AutoDebug_v0423/*.md
!/work/NSS_AutoDebug_v0423/*.cmd
# Dumps and local data are private. Skill metadata is an explicit text-only exception.
*.json
!skills-lock.json
!/.agents/skills/**/*.json
*.csv
!catalog.csv
# Nonportable state, runtimes, distributions, generated results and backup copies.
**/.git/
**/.venv/
**/venv/
**/env/
**/node_modules/
**/[Rr]untime/
**/py312/
**/[Bb]in/
**/[Oo]bj/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/[Rr]uns/
**/[Ee]vidence/
**/[Hh]istory/
**/graphify-out/
**/dist/
**/build/
**/wheels/
**/demo/
**/dumps/
**/dump/
**/local-backups/
