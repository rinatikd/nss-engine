const SEND_STATES = new Set(['CONFIRMED', 'UNKNOWN', 'NOT_PERFORMED', 'BLOCKED']);
const LEGACY_SEND_STATES = SEND_STATES;
const LEGACY_SEND_ORIGINS = new Set(['https://claude.ai', 'https://gemini.google.com', 'https://chat.deepseek.com']);
const LEGACY_SEND_ID = /^[a-zA-Z0-9_-]{1,80}$/;
const LEGACY_SEND_AGENT = /^[a-z0-9_-]{1,32}$/;
const LEGACY_SEND_FINGERPRINT = /^[a-f0-9]{64}$/;
const LEGACY_SEND_MAX_ENTRIES = 10000;

function writeSignedMarker(file, body, key, code) {
  const data = JSON.stringify({ ...body, hmac: hmac(key, JSON.stringify(body)) }) + '\n';
  const temp = file + '.tmp-' + process.pid + '-' + crypto.randomUUID();
  let fd;
  try {
    fd = fs.openSync(temp, 'wx', 0o600);
    fs.writeFileSync(fd, data, 'utf8'); fs.fsyncSync(fd); fs.closeSync(fd); fd = undefined;
    fs.renameSync(temp, file); fsyncDirectory(path.dirname(file));
  } catch {
    if (fd !== undefined) try { fs.closeSync(fd); } catch {}
    try { fs.unlinkSync(temp); } catch {}
    throw Error(code);
  }
}
function readLegacySendSnapshot(file) {
  let stat;
  try { stat = fs.lstatSync(file); }
  catch (error) { if (error.code === 'ENOENT') return null; throw Error('LEGACY_SEND_JOURNAL_READ_FAILED'); }
  if (!stat.isFile() || stat.isSymbolicLink()) throw Error('LEGACY_SEND_JOURNAL_CORRUPT_FAIL_CLOSED');
  if (stat.size > 8 * 1024 * 1024) throw Error('LEGACY_SEND_JOURNAL_TOO_LARGE_FAIL_CLOSED');
  let raw;
  try { raw = fs.readFileSync(file, 'utf8'); } catch { throw Error('LEGACY_SEND_JOURNAL_READ_FAILED'); }
  let parsed;
  try { parsed = JSON.parse(raw); } catch { throw Error('LEGACY_SEND_JOURNAL_CORRUPT_FAIL_CLOSED'); }
  if (![1, 2].includes(parsed?.version) || !parsed.entries || typeof parsed.entries !== 'object' || Array.isArray(parsed.entries))
    throw Error('LEGACY_SEND_JOURNAL_CORRUPT_FAIL_CLOSED');
  const entries = [];
  for (const [id, old] of Object.entries(parsed.entries)) {
    const entry = parsed.version === 1
      ? { ...old, identityVersion: 1, payloadFingerprint: old?.fingerprint, origin: null, conversationFingerprint: null }
      : { ...old };
    if (!LEGACY_SEND_ID.test(id) || entry?.requestId !== id || !LEGACY_SEND_AGENT.test(entry.agent || '') ||
        !Number.isSafeInteger(entry.tabId) || entry.tabId <= 0 || !LEGACY_SEND_FINGERPRINT.test(entry.fingerprint || '') ||
        (entry.identityVersion === 2 && (!LEGACY_SEND_ORIGINS.has(entry.origin) ||
          !LEGACY_SEND_FINGERPRINT.test(entry.conversationFingerprint || '') || !LEGACY_SEND_FINGERPRINT.test(entry.payloadFingerprint || ''))) ||
        (entry.identityVersion !== 1 && entry.identityVersion !== 2) || !LEGACY_SEND_STATES.has(entry.status) ||
        typeof entry.createdAt !== 'string' ||
        !(entry.baseline === null || (Number.isSafeInteger(entry.baseline) && entry.baseline >= 0)) ||
        !(entry.transportConfirmed === null || typeof entry.transportConfirmed === 'boolean'))
      throw Error('LEGACY_SEND_JOURNAL_CORRUPT_FAIL_CLOSED');
    entries.push({ ...entry, settled: true });
  }
  if (entries.length > LEGACY_SEND_MAX_ENTRIES) throw Error('LEGACY_SEND_JOURNAL_TOO_LARGE_FAIL_CLOSED');
  return { raw, sourceSha256: crypto.createHash('sha256').update(raw, 'utf8').digest('hex'), entries };
}

export class SendJournal {
  constructor(stateDir, key) {
    if (!Buffer.isBuffer(key) || key.length < 32) throw Error('JOURNAL_HMAC_KEY_REQUIRED');
    this.stateDir = stateDir;
    this.key = Buffer.from(key);
    this.file = path.join(stateDir, 'send-journal.jsonl');
    this.legacyFile = path.join(stateDir, 'send-journal.json');
    this.migrationFile = path.join(stateDir, 'send-journal.migration-v1.json');
    this.entries = new Map();
    this.legacyImported = new Map();
    this.migrationComplete = null;

    const legacy = readLegacySendSnapshot(this.legacyFile);
    let marker = null;
    try {
      const raw = fs.readFileSync(this.migrationFile, 'utf8');
      const x = JSON.parse(raw); const body = { version: x.version, status: x.status, sourceSha256: x.sourceSha256, count: x.count };
      if (x.version !== 1 || !['in-progress', 'complete'].includes(x.status) ||
          !/^[a-f0-9]{64}$/.test(x.sourceSha256 || '') || !Number.isSafeInteger(x.count) || x.count < 0 ||
          !safeHexEqual(x.hmac, hmac(key, JSON.stringify(body)))) throw Error();
      marker = body;
    } catch (error) {
      if (error.code !== 'ENOENT') throw Error('SEND_JOURNAL_MIGRATION_MARKER_CORRUPT_FAIL_CLOSED');
    }

    if (legacy && !marker) {
      if (fs.existsSync(this.file) || fs.existsSync(this.file + '.checkpoint.json') || fs.existsSync(this.file + '.checkpoint.ready'))
        throw Error('SEND_JOURNAL_MIGRATION_STATE_AMBIGUOUS_FAIL_CLOSED');
      marker = { version: 1, status: 'in-progress', sourceSha256: legacy.sourceSha256, count: legacy.entries.length };
      writeSignedMarker(this.migrationFile, marker, key, 'SEND_JOURNAL_MIGRATION_MARKER_WRITE_FAILED');
    }
    if (marker && legacy && marker.sourceSha256 !== legacy.sourceSha256)
      throw Error('SEND_JOURNAL_LEGACY_SOURCE_CHANGED_FAIL_CLOSED');
    if (marker && !legacy && marker.status === 'in-progress')
      throw Error('SEND_JOURNAL_MIGRATION_SOURCE_MISSING_FAIL_CLOSED');

    this.log = new AppendLog(this.file, key);
    this.log.load((rec) => {
      if (rec.type === 'legacy-import') {
        if (!marker || rec.sourceSha256 !== marker.sourceSha256 || !Number.isSafeInteger(rec.index) || rec.index < 0 ||
            rec.index >= marker.count || !rec.entry || rec.entry.requestId !== rec.requestId || this.legacyImported.has(rec.index))
          throw Error('SEND_JOURNAL_MIGRATION_RECORD_INVALID_FAIL_CLOSED');
        this.legacyImported.set(rec.index, true);
        this.entries.set(rec.requestId, { ...rec.entry, settled: true });
      } else if (rec.type === 'migration-complete') {
        if (!marker || rec.sourceSha256 !== marker.sourceSha256 || rec.count !== marker.count || this.migrationComplete)
          throw Error('SEND_JOURNAL_MIGRATION_RECORD_INVALID_FAIL_CLOSED');
        this.migrationComplete = rec;
      } else if (rec.type === 'begin' && typeof rec.requestId === 'string') {
        if (this.entries.has(rec.requestId)) throw Error('SEND_JOURNAL_DUPLICATE_REQUEST_FAIL_CLOSED');
        this.entries.set(rec.requestId, { ...rec });
      } else if (rec.type === 'settle' && typeof rec.requestId === 'string' && this.entries.has(rec.requestId)) {
        const entry = this.entries.get(rec.requestId);
        if (!entry.settled) { entry.settled = true; entry.status = rec.status; Object.assign(entry, rec.extra || {}); }
      } else throw Error('SEND_JOURNAL_RECORD_INVALID_FAIL_CLOSED');
    });

    if (marker) {
      if (marker.status === 'complete') {
        if (!this.migrationComplete || this.legacyImported.size !== marker.count)
          throw Error('SEND_JOURNAL_MIGRATION_INCOMPLETE_FAIL_CLOSED');
      } else {
        for (let i = 0; i < legacy.entries.length; i++) {
          if (this.legacyImported.has(i)) continue;
          const entry = legacy.entries[i];
          this.log.append({ type: 'legacy-import', index: i, requestId: entry.requestId,
            sourceSha256: marker.sourceSha256, entry: { ...entry, settled: true } });
          this.legacyImported.set(i, true);
          this.entries.set(entry.requestId, { ...entry, settled: true });
        }
        if (!this.migrationComplete) {
          this.log.append({ type: 'migration-complete', sourceSha256: marker.sourceSha256, count: marker.count });
          this.migrationComplete = { sourceSha256: marker.sourceSha256, count: marker.count };
        }
        marker = { ...marker, status: 'complete' };
        writeSignedMarker(this.migrationFile, marker, key, 'SEND_JOURNAL_MIGRATION_MARKER_WRITE_FAILED');
      }
    }
  }
  get(requestId) { return this.entries.get(requestId) || null; }
  begin(entry) {
    const prev = this.entries.get(entry.requestId);
    if (prev) return { duplicate: true, entry: prev };
    const rec = { ...entry, status: 'UNKNOWN', settled: false, baseline: null, transportConfirmed: false };
    this.log.append({ type: 'begin', ...rec });
    this.entries.set(entry.requestId, rec);
    return { duplicate: false, entry: rec };
  }
  settle(requestId, status, extra = {}) {
    if (!SEND_STATES.has(status)) throw Error('SEND_JOURNAL_STATUS_INVALID');
    const rec = this.entries.get(requestId);
    if (!rec || rec.settled) return rec || null;
    this.log.append({ type: 'settle', requestId, status, extra });
    rec.settled = true; rec.status = status; Object.assign(rec, extra);
    return rec;
  }
}
export function conversationFingerprint(origin, conversationId, key) {
  return hmac(key, JSON.stringify(['chrome-bridge/conversation/v1', origin, conversationId]));
}
export function legacyRequestFingerprint(name, tabId, text, key) {
  return hmac(key, JSON.stringify([name, tabId, text]));
}
export function requestFingerprint(name, tabId, text, key, context) {
  return hmac(key, JSON.stringify(['chrome-bridge/send/v2', name, tabId, context.origin, context.conversationId, text]));
}

// ---------------------------------------------------------------------------
// 6. Provider transaction journal (PR #132 state machine + tail checkpoint)
// ---------------------------------------------------------------------------
export function deriveProviderJournalKey(agentToken) {
  if (typeof agentToken !== 'string' || !/^[a-f0-9]{64}$/.test(agentToken)) throw Error('PROVIDER_JOURNAL_KEY_INVALID');
  return crypto.createHmac('sha256', 'chrome-bridge/provider-journal/v1').update(agentToken, 'utf8').digest();
}
const ID=/^[A-Za-z0-9_-]{8,100}$/;
const CONVERSATION_ID=/^[A-Za-z0-9_-]{8,160}$/;
const PROVIDERS={
  'https://claude.ai':'claude',
  'https://gemini.google.com':'gemini',
  'https://chat.deepseek.com':'deepseek',
  'https://grok.com':'grok',
  'https://chat.qwen.ai':'qwen',
  'https://www.kimi.ai':'kimi'
};
const STATES=new Set(['PREPARING','PREPARED','COMMITTING','SENT','UNKNOWN','NOT_PERFORMED','BLOCKED','REVOKED','STOP_REQUESTED','STOPPED_CLEAN','STOP_AFTER_COMMIT']);
const MAX_BYTES=16*1024*1024;
function fsyncJournalDirectory(dir, fsOps=fs) { let fd; try { fd=fsOps.openSync(dir,'r'); fsOps.fsyncSync(fd); } catch(e) { if(!['EINVAL','ENOTSUP','EISDIR','EPERM','EACCES','EBADF'].includes(e?.code)) throw e; } finally { if(fd!==undefined)try{fsOps.closeSync(fd);}catch{} } }
function quiescencePayload(proof, identity) { return JSON.stringify({ purpose:'chrome-bridge/provider-quiescence/v1', requestId:identity.requestId, taskId:identity.taskId, providerId:identity.providerId, tabId:identity.tabId, origin:identity.origin, conversationId:identity.conversationId, epoch:proof.epoch, nextEpoch:proof.nextEpoch, unresolved:proof.unresolved, outstandingPrepared:proof.outstandingPrepared, attestationId:proof.attestationId }); }
function signQuiescence(proof, identity, key) { return crypto.createHmac('sha256',key).update(quiescencePayload(proof,identity),'utf8').digest('hex'); }
export function verifyQuiescence(proof, identity, key) {
  if (!proof || proof.verified !== true || proof.epoch !== identity?.epoch ||
      proof.nextEpoch !== identity.epoch + 1 || proof.unresolved !== 0 ||
      proof.outstandingPrepared !== 0 || !/^attest_[a-f0-9]{24}$/.test(proof.attestationId || '') ||
      typeof proof.signature !== 'string' || !/^[a-f0-9]{64}$/.test(proof.signature) ||
      !Buffer.isBuffer(key) || key.length < 32) return false;
  const expected = Buffer.from(signQuiescence(proof, identity, key), 'hex');
  const supplied = Buffer.from(proof.signature, 'hex');
  return supplied.length === expected.length && crypto.timingSafeEqual(supplied, expected);
}
const clone=value=>value==null?value:JSON.parse(JSON.stringify(value));

export function validateProviderIdentity(input) {
  if(!input||typeof input!=='object')throw Error('PROVIDER_IDENTITY_REQUIRED');
  if(!ID.test(input.requestId||'')||!ID.test(input.taskId||''))throw Error('PROVIDER_REQUEST_ID_INVALID');
  if(PROVIDERS[input.origin]!==input.providerId)throw Error('PROVIDER_ORIGIN_MISMATCH');
  if(!Number.isSafeInteger(input.tabId)||input.tabId<=0)throw Error('PROVIDER_TAB_ID_INVALID');
  if(typeof input.conversationId!=='string'||!CONVERSATION_ID.test(input.conversationId))throw Error('PROVIDER_CONVERSATION_INVALID');
  if(!Number.isSafeInteger(input.epoch)||input.epoch<1)throw Error('PROVIDER_EPOCH_INVALID');
  return Object.freeze({
    requestId:input.requestId,taskId:input.taskId,providerId:input.providerId,
    tabId:input.tabId,origin:input.origin,conversationId:input.conversationId,epoch:input.epoch
  });
}

function identityEqual(a,b) {
  return !!a&&!!b&&a.requestId===b.requestId&&a.taskId===b.taskId&&
    a.providerId===b.providerId&&a.tabId===b.tabId&&a.origin===b.origin&&
    a.conversationId===b.conversationId&&a.epoch===b.epoch;
}
function hash(key,value) {
  return crypto.createHmac('sha256',key).update(value,'utf8').digest('hex');
}
function tokenHash(token) { return crypto.createHash('sha256').update(token,'utf8').digest('hex'); }

export class ProviderJournal {
  constructor(stateDir,hmacKey,bridgeEpoch=crypto.randomUUID(),{fsOps=fs,now=Date.now,maxBytes=MAX_BYTES}={}) {
    if(typeof stateDir!=='string'||!path.isAbsolute(stateDir))throw Error('PROVIDER_JOURNAL_DIR_REQUIRED');
    if(!Buffer.isBuffer(hmacKey)||hmacKey.length<32)throw Error('PROVIDER_JOURNAL_KEY_REQUIRED');
    if(!ID.test(bridgeEpoch))throw Error('PROVIDER_BRIDGE_EPOCH_INVALID');
    if(!Number.isSafeInteger(maxBytes)||maxBytes<1024||maxBytes>64*1024*1024)throw Error('PROVIDER_JOURNAL_SIZE_INVALID');
    this.fs=fsOps;this.now=now;this.key=Buffer.from(hmacKey);this.bridgeEpoch=bridgeEpoch;this.maxBytes=maxBytes;
    this.fs.mkdirSync(stateDir,{recursive:true,mode:0o700});
    this.file=path.join(stateDir,'provider-transactions.jsonl');
    this.lockFile=this.file+'.lock';
    this.checkpointFile=this.file+'.checkpoint.json';
    this.checkpointReadyFile=this.file+'.checkpoint.ready';
    this.records=[];this.transactions=new Map();this.tabEpochs=new Map();this.lastHash='0'.repeat(64);
    this.#load();
    // A restart invalidates every in-flight/prepared transaction. Never infer
    // that a prior browser click did not happen merely because its ACK is gone.
    for(const tx of this.transactions.values()) {
      if(['PREPARING','PREPARED','COMMITTING'].includes(tx.state)) {
        this.outcome(tx.identity,'UNKNOWN','BRIDGE_RESTART');
      }
    }
  }

  #recordHash(record) {
    const body={seq:record.seq,eventId:record.eventId,type:record.type,identity:record.identity,data:record.data,prevHash:record.prevHash};
    return hash(this.key,JSON.stringify(body));
  }

  #checkpointMac(body) {
    return crypto.createHmac('sha256',this.key).update(JSON.stringify(body),'utf8').digest('hex');
  }
  #writeCheckpoint(seq,tailHash) {
    const body={version:1,seq,tailHash};
    const data=JSON.stringify({...body,hmac:this.#checkpointMac(body)})+'\n';
    const temp=this.checkpointFile+'.tmp-'+process.pid+'-'+crypto.randomUUID();
    let fd;
    try {
      fd=this.fs.openSync(temp,'wx',0o600);
      this.fs.writeFileSync(fd,data,'utf8'); this.fs.fsyncSync(fd); this.fs.closeSync(fd); fd=undefined;
      this.fs.renameSync(temp,this.checkpointFile);
      fsyncJournalDirectory(path.dirname(this.file),this.fs);
    } catch { if(fd!==undefined)try{this.fs.closeSync(fd);}catch{} try{this.fs.unlinkSync(temp);}catch{} throw Error('PROVIDER_CHECKPOINT_WRITE_FAILED'); }
  }
  #writeCheckpointReady() {
    const body={version:1,file:'provider-transactions.jsonl'};
    const data=JSON.stringify({...body,hmac:this.#checkpointMac(body)})+'\n';
    const temp=this.checkpointReadyFile+'.tmp-'+process.pid+'-'+crypto.randomUUID();
    let fd;
    try {
      fd=this.fs.openSync(temp,'wx',0o600); this.fs.writeFileSync(fd,data,'utf8'); this.fs.fsyncSync(fd);
      this.fs.closeSync(fd); fd=undefined; this.fs.renameSync(temp,this.checkpointReadyFile);
      fsyncJournalDirectory(path.dirname(this.file),this.fs);
    } catch { if(fd!==undefined)try{this.fs.closeSync(fd);}catch{} try{this.fs.unlinkSync(temp);}catch{} throw Error('PROVIDER_CHECKPOINT_READY_WRITE_FAILED'); }
  }
  #readCheckpoint(rows) {
    let readyExists=false;
    try {
      const rs=this.fs.lstatSync(this.checkpointReadyFile);
      if(!rs.isFile()||rs.isSymbolicLink())throw Error();
      const marker=JSON.parse(this.fs.readFileSync(this.checkpointReadyFile,'utf8'));
      const body={version:marker.version,file:marker.file};
      if(marker.version!==1||marker.file!=='provider-transactions.jsonl'||marker.hmac!==this.#checkpointMac(body))throw Error();
      readyExists=true;
    } catch(e) { if(e?.code!=='ENOENT')throw Error('PROVIDER_CHECKPOINT_READY_CORRUPT_FAIL_CLOSED'); }
    let cp;
    try {
      const st=this.fs.lstatSync(this.checkpointFile);
      if(!st.isFile()||st.isSymbolicLink())throw Error();
      cp=JSON.parse(this.fs.readFileSync(this.checkpointFile,'utf8'));
    } catch(e) {
      if(e?.code!=='ENOENT')throw Error('PROVIDER_CHECKPOINT_CORRUPT_FAIL_CLOSED');
      if(readyExists)throw Error('PROVIDER_CHECKPOINT_MISSING_FAIL_CLOSED');
      // One-time adoption of a pre-checkpoint PR #132 journal: its complete
      // HMAC chain has just been validated. Subsequent starts require the anchor.
      this.#writeCheckpoint(rows.length,rows.length?rows[rows.length-1].hash:ZERO_HASH);
      this.#writeCheckpointReady();
      return;
    }
    const body={version:cp.version,seq:cp.seq,tailHash:cp.tailHash};
    if(cp.version!==1||!Number.isSafeInteger(cp.seq)||cp.seq<0||typeof cp.tailHash!=='string'||
      !/^[a-f0-9]{64}$/.test(cp.tailHash)||cp.hmac!==this.#checkpointMac(body))
      throw Error('PROVIDER_CHECKPOINT_CORRUPT_FAIL_CLOSED');
    if(cp.seq>rows.length)throw Error('PROVIDER_JOURNAL_TAIL_TRUNCATED_FAIL_CLOSED');
    const expected=cp.seq===0?ZERO_HASH:rows[cp.seq-1]?.hash;
    if(expected!==cp.tailHash)throw Error('PROVIDER_CHECKPOINT_MISMATCH_FAIL_CLOSED');
    if(cp.seq<rows.length)this.#writeCheckpoint(rows.length,rows[rows.length-1].hash);
    if(!readyExists)this.#writeCheckpointReady();
  }
  #load() {
    let stat;
    try{stat=this.fs.lstatSync(this.file);}
    catch(error){if(error.code==='ENOENT'){this.#readCheckpoint([]);return;}throw Error('PROVIDER_JOURNAL_READ_FAILED');}
    if(!stat.isFile()||stat.isSymbolicLink())throw Error('PROVIDER_JOURNAL_CORRUPT_FAIL_CLOSED');
    if(stat.size>this.maxBytes)throw Error('PROVIDER_JOURNAL_TOO_LARGE_FAIL_CLOSED');
    let raw;
    try{raw=this.fs.readFileSync(this.file,'utf8');}catch{throw Error('PROVIDER_JOURNAL_READ_FAILED');}
    if(raw&&!raw.endsWith('\n'))throw Error('PROVIDER_JOURNAL_CORRUPT_FAIL_CLOSED');
    let expectedSeq=1,previous=ZERO_HASH;
    const rows=[];
    for(const line of (raw?raw.slice(0,-1).split('\n'):[])) {
      if(!line)throw Error('PROVIDER_JOURNAL_CORRUPT_FAIL_CLOSED');
      let record;
      try{record=JSON.parse(line);}catch{throw Error('PROVIDER_JOURNAL_CORRUPT_FAIL_CLOSED');}
      if(record.seq!==expectedSeq||record.prevHash!==previous||!ID.test(record.eventId||'')||
        typeof record.type!=='string'||!record.data||typeof record.data!=='object'||
        !record.identity||!identityEqual(validateProviderIdentity(record.identity),record.identity)||
        record.hash!==this.#recordHash(record))throw Error('PROVIDER_JOURNAL_CORRUPT_FAIL_CLOSED');
      this.#apply(record); this.records.push(record); rows.push(record); previous=record.hash; expectedSeq++;
    }
    this.lastHash=previous;
    this.#readCheckpoint(rows);
  }

  #apply(record) {
    const {type,identity,data}=record;
    if(type==='epoch.initialized')this.tabEpochs.set(identity.tabId,data.epoch);
    else if(type==='epoch.revoked')this.tabEpochs.set(identity.tabId,data.nextEpoch);
    else if(type==='prepare.started')this.transactions.set(identity.requestId,{
      identity:clone(identity),state:'PREPARING',payloadHash:data.payloadHash,bridgeEpoch:data.bridgeEpoch,
      createdAt:data.at
    });
    else if(type==='prepare.completed') {
      const old=this.transactions.get(identity.requestId)||{identity:clone(identity)};
      this.transactions.set(identity.requestId,{...old,state:'PREPARED',preparedId:data.preparedId,
        expiresAt:data.expiresAt,tokenHash:data.tokenHash,bridgeEpoch:data.bridgeEpoch,payloadHash:data.payloadHash});
    } else if(type==='commit.started') {
      const old=this.transactions.get(identity.requestId);
      if(old)this.transactions.set(identity.requestId,{...old,state:'COMMITTING'});
    } else if(type==='commit.completed') {
      const old=this.transactions.get(identity.requestId);
      if(old)this.transactions.set(identity.requestId,{...old,state:'SENT',clickedAt:data.clickedAt,clickedSend:true});
    } else if(type==='transaction.outcome') {
      const old=this.transactions.get(identity.requestId)||{identity:clone(identity)};
      this.transactions.set(identity.requestId,{...old,state:data.state,reasonCode:data.reasonCode||null,
        quarantineId:data.quarantineId||null,nextEpoch:data.nextEpoch||null});
    } else if(type==='stop.clean') {
      const old=this.transactions.get(identity.requestId)||{identity:clone(identity)};
      this.transactions.set(identity.requestId,{...old,state:'STOPPED_CLEAN',quiescence:clone(data.quiescence),nextEpoch:data.nextEpoch});
    } else if(type==='stop.requested') {
      const old=this.transactions.get(identity.requestId)||{identity:clone(identity)};
      this.transactions.set(identity.requestId,{...old,state:'STOP_REQUESTED',nextEpoch:data.nextEpoch||null});
    } else if(type==='stop.after_commit') {
      const old=this.transactions.get(identity.requestId)||{identity:clone(identity)};
      this.transactions.set(identity.requestId,{...old,state:'STOP_AFTER_COMMIT',nextEpoch:data.nextEpoch||null});
    }
  }

  #append(type,identity,data) {
    const lock=this.fs.openSync(this.lockFile,'wx',0o600);
    let fd;
    try {
      this.fs.writeFileSync(lock,JSON.stringify({pid:process.pid,at:new Date(this.now()).toISOString()}));
      this.fs.fsyncSync(lock);
      const record={
        seq:this.records.length+1,eventId:crypto.randomUUID(),type,
        identity:clone(identity),data:clone(data),prevHash:this.lastHash
      };
      record.hash=this.#recordHash(record);
      const line=JSON.stringify(record)+'\n';
      const current=this.fs.existsSync(this.file)?this.fs.statSync(this.file).size:0;
      if(current+Buffer.byteLength(line,'utf8')>this.maxBytes)throw Error('PROVIDER_JOURNAL_FULL_FAIL_CLOSED');
      fd=this.fs.openSync(this.file,'a',0o600);
      this.fs.writeFileSync(fd,line,'utf8');this.fs.fsyncSync(fd);this.fs.closeSync(fd);fd=undefined;
      this.#apply(record);this.records.push(record);this.lastHash=record.hash;
      this.#writeCheckpoint(record.seq,record.hash);
      return clone(record);
    } finally {
      if(fd!==undefined)try{this.fs.closeSync(fd);}catch{}
      try{this.fs.closeSync(lock);}catch{}
      try{this.fs.unlinkSync(this.lockFile);}catch{}
    }
  }

  #ensureEpoch(identity) {
    const current=this.tabEpochs.get(identity.tabId);
    if(current===undefined) {
      this.#append('epoch.initialized',identity,{epoch:identity.epoch,at:new Date(this.now()).toISOString()});
      return;
    }
    if(current!==identity.epoch)throw Error('STALE_FENCING_EPOCH');
  }

  #fencingToken(tx) {
    return hash(this.key,JSON.stringify({
      purpose:'chrome-bridge/provider-fencing/v1',bridgeEpoch:tx.bridgeEpoch,
      identity:tx.identity,preparedId:tx.preparedId,payloadHash:tx.payloadHash,expiresAt:tx.expiresAt
    }));
  }

  beginPrepare(input,payloadHash) {
    const identity=validateProviderIdentity(input);
    if(typeof payloadHash!=='string'||!/^[a-f0-9]{64}$/.test(payloadHash))throw Error('PROVIDER_PAYLOAD_HASH_INVALID');
    const old=this.transactions.get(identity.requestId);
    if(old) {
      if(!identityEqual(old.identity,identity)||old.payloadHash!==payloadHash)throw Error('PROVIDER_REQUEST_ID_CONFLICT');
      if(old.state==='PREPARED'&&old.bridgeEpoch===this.bridgeEpoch&&Date.parse(old.expiresAt)>this.now()&&
         this.tabEpochs.get(identity.tabId)===identity.epoch) {
        return {duplicate:true,transaction:this.status(identity),fencingToken:this.#fencingToken(old)};
      }
      if(['PREPARING','COMMITTING','UNKNOWN','SENT','REVOKED','STOPPED_CLEAN',
          'NOT_PERFORMED','BLOCKED','STOP_REQUESTED','STOP_AFTER_COMMIT'].includes(old.state)) {
        return {duplicate:true,transaction:this.status(identity)};
      }
      throw Error('PROVIDER_REQUEST_IN_PROGRESS');
    }
    this.#ensureEpoch(identity);
    for(const existing of this.transactions.values()) {
      if(existing.identity.tabId===identity.tabId&&
         ['PREPARING','PREPARED','COMMITTING','UNKNOWN','STOP_REQUESTED'].includes(existing.state)) {
        throw Error('PROVIDER_TAB_QUARANTINED');
      }
    }
    this.#append('prepare.started',identity,{payloadHash,bridgeEpoch:this.bridgeEpoch,at:new Date(this.now()).toISOString()});
    return {duplicate:false};
  }

  completePrepare(input,{preparedId,expiresAt}) {
    const identity=validateProviderIdentity(input);
    const tx=this.transactions.get(identity.requestId);
    if(!tx||tx.state!=='PREPARING'||!identityEqual(tx.identity,identity))throw Error('PROVIDER_PREPARE_STATE_INVALID');
    if(typeof preparedId!=='string'||!ID.test(preparedId)||!Number.isFinite(Date.parse(expiresAt))||Date.parse(expiresAt)<=this.now())throw Error('PROVIDER_PREPARE_RECEIPT_INVALID');
    const token=this.#fencingToken({...tx,preparedId,expiresAt});
    this.#append('prepare.completed',identity,{preparedId,expiresAt,payloadHash:tx.payloadHash,
      bridgeEpoch:this.bridgeEpoch,tokenHash:tokenHash(token)});
    return {state:'PREPARED',identity,requestId:identity.requestId,payloadHash:tx.payloadHash,preparedId,expiresAt,fencingToken:token,
      sideEffect:'composer-filled-no-send',clickedSend:false};
  }

  // Validate epoch -> state -> TTL -> prepared identity/payload -> token
  // without consuming the one-shot requestId. The caller can then verify the
  // active Session Authorization lease; beginCommit repeats every check and
  // durably consumes the requestId immediately before extension dispatch.
  validateCommit(input,{preparedId,fencingToken,payloadHash}) {
    const identity=validateProviderIdentity(input);
    this.#ensureEpoch(identity);
    const tx=this.transactions.get(identity.requestId);
    if(!tx||!identityEqual(tx.identity,identity)||tx.state!=='PREPARED')throw Error('PROVIDER_PREPARE_NOT_COMMITTABLE');
    if(tx.bridgeEpoch!==this.bridgeEpoch||Date.parse(tx.expiresAt)<=this.now())throw Error('PROVIDER_PREPARE_EXPIRED_OR_RESTARTED');
    if(tx.preparedId!==preparedId)throw Error('PROVIDER_PREPARED_ID_MISMATCH');
    if(payloadHash!==tx.payloadHash)throw Error('PROVIDER_PAYLOAD_HASH_MISMATCH');
    const expectedToken=this.#fencingToken(tx);
    if(tx.tokenHash!==tokenHash(expectedToken))throw Error('PROVIDER_JOURNAL_TOKEN_CORRUPT');
    const expected=Buffer.from(expectedToken,'hex');
    const supplied=Buffer.from(typeof fencingToken==='string'?fencingToken:'','hex');
    if(supplied.length!==expected.length||!crypto.timingSafeEqual(supplied,expected))throw Error('PROVIDER_FENCING_TOKEN_INVALID');
    return clone(tx);
  }

  beginCommit(input,commitArgs) {
    const identity=validateProviderIdentity(input);
    const tx=this.validateCommit(identity,commitArgs);
    this.#append('commit.started',identity,{preparedId:commitArgs.preparedId,bridgeEpoch:this.bridgeEpoch,at:new Date(this.now()).toISOString()});
    return tx;
  }

